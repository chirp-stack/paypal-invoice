<div style="background:#f6f7f9; padding:20px; font-family:Arial,sans-serif;">
    <div style="background:#fff; max-width:600px; margin:auto; padding:30px; border-radius:8px; box-shadow:0 2px 5px rgba(0,0,0,0.05);">
      <img src="https://www.paypalobjects.com/webstatic/mktg/logo/pp_cc_mark_111x69.jpg" alt="PayPal" style="height:50px; display:block; margin:auto; margin-bottom:30px;">
      <h2 style="color:#0070ba; text-align:center;">Payment Notification</h2>
      <p style="font-size:16px; color:#333; margin-top:30px;">A customer has paid an invoice.</p>
      <table style="width:100%; margin-top:20px; font-size:15px;">
        <tr>
          <td><strong>Customer Email:</strong></td>
          <td><%= customerEmail %></td>
        </tr>
        <tr>
          <td><strong>Invoice ID:</strong></td>
          <td><%= invoiceId %></td>
        </tr>
      </table>
      <div style="text-align:center; margin-top:30px;">
        <a href="https://www.paypal.com/signin" style="background:#0070ba; color:white; padding:10px 20px; text-decoration:none; border-radius:5px;">View Invoice</a>
      </div>
      <hr style="margin-top:40px; border:0; border-top:1px solid #eee;">
      <p style="font-size:12px; color:#888; text-align:center;">© 2025 PayPal, Inc. All rights reserved.</p>
    </div>
  </div>